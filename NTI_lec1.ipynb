   "source": [
    "\n",
    "n = map(float, input('Enter product prices: ').split())\n",
    "for i in n:\n",
    "    if i > 0 and i < 50:\n",
    "        print(f'{i} is cheap')\n",
    "    elif i >= 50 and i < 100:\n",
    "        print(f'{i} is mid')\n",
    "    else:\n",
    "        print(f'{i} is expensive')\n"
   ]
